# ============================================================
# Finanzas Personales — variables de entorno (ejemplo)
# Copia este archivo a `.env` y ajústalo. NUNCA subas un `.env` real.
# ============================================================

# --- Puertos (deliberadamente no convencionales) ---
# Backend (uvicorn / FastAPI)
BACKEND_PORT=7412
# Frontend (nginx sirviendo el build de Vite, con proxy /api -> backend)
FRONTEND_PORT=7413

# --- CORS ---
# Origin exacto permitido por el backend. Debe coincidir con donde corre el
# frontend. Nunca usar wildcard "*".
FRONTEND_ORIGIN=http://localhost:7413

# --- API externa de tipo de cambio ---
# Gratuita, sin API key. Se cachea 1x/día en la tabla exchange_rates.
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
